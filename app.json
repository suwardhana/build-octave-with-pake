{
  "$schema": "https://raw.githubusercontent.com/tw93/Pake/main/schema/pake.schema.json",
  "url": "https://music.octavestreaming.com/",
  "name": "Octave Music",
  "identifier": "com.octave.music",
  "icon": "./assets/music.icns",
  "appVersion": "1.1.1",
  "hideTitleBar": true,
  "hideOnClose": true,
  "showSystemTray": true,
  "systemTrayIcon": "./assets/tray-icon-128.png",
  "width": 1280,
  "height": 800,
  "minWidth": 800,
  "minHeight": 600,
  "darkMode": true,
  "disabledWebShortcuts": true,
  "inject": [
    "./src/css/octave-native.css",
    "./src/js/octave-core.js",
    "./src/js/octave-native.js",
    "./src/js/octave-media.js",
    "./src/js/octave-cache.js",
    "./src/js/octave-prefetch.js",
    "./src/js/octave-media-lazy.js",
    "./src/js/octave-depin.js",
    "./src/js/disable-right-click.js"
  ]
}